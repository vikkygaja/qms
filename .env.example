# Copy to .env and change every value marked CHANGE-ME. Never commit .env.
# "development" enables /api/v1/docs; anything else disables it.
APP_ENV=production

# Ports (host side). Postgres, API and MinIO bind to 127.0.0.1 only; only WEB_PORT is LAN-visible.
WEB_PORT=8080
API_PORT=8000
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

POSTGRES_DB=qms
POSTGRES_USER=qms
POSTGRES_PASSWORD=CHANGE-ME-db-password

MINIO_ROOT_USER=qms-minio
MINIO_ROOT_PASSWORD=CHANGE-ME-minio-password
